<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">

    <!-- Core greys the Validate button out through a CSS class, which also
         swallows the click, so its own "select the customer" message is never
         reached. Say why the button is dead. -->
    <t
        t-name="l10n_ro_pos_refund.PaymentScreenCustomerRequired"
        t-inherit="point_of_sale.PaymentScreenButtons"
        t-inherit-mode="extension"
    >
        <xpath expr="//div[hasclass('payment-buttons')]/div[1]" position="before">
            <div
                t-if="currentOrder.l10nRoNeedsCustomer"
                class="alert alert-warning d-flex align-items-center gap-2 mb-1 py-2"
            >
                <i class="fa fa-exclamation-triangle" role="img" />
                <span>Select the customer: the refund is issued as a credit note
                    and a payment disposal in their name.</span>
            </div>
        </xpath>
    </t>

</templates>
