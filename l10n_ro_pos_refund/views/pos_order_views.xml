<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_pos_pos_form_l10n_ro_refund" model="ir.ui.view">
        <field name="name">pos.order.form.l10n.ro.refund</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_view_invoice']" position="after">
                <field name="l10n_ro_payment_disposal_id" invisible="1" />
                <button
                    name="action_l10n_ro_print_payment_disposal"
                    string="Payment Disposal"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-money"
                    invisible="not l10n_ro_payment_disposal_id"
                />
            </xpath>
        </field>
    </record>
</odoo>
