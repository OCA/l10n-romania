<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_l10n_ro_message_spv_form_inherit_purchase" model="ir.ui.view">
        <field name="name">l10n.ro.message.spv.form.inherit.purchase</field>
        <field name="model">l10n.ro.message.spv</field>
        <field
            name="inherit_id"
            ref="l10n_ro_message_spv.view_l10n_ro_message_spv_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//form/header" position="inside">
                <button
                    name="action_find_purchase"
                    string="Find Purchase"
                    type="object"
                    class="btn-secondary"
                    help="Search a purchase order by Purchase Reference/Reference and link it when found"
                />
                <button
                    name="action_create_purchase"
                    string="Create Purchase"
                    type="object"
                    class="btn-primary"
                    help="Search a purchase order; when none is found, create a new one and link it"
                />
            </xpath>
            <xpath expr="//field[@name='ref']" position="after">
                <field name="purchase_ref" />
                <field name="purchase_order_id" />
            </xpath>
        </field>
    </record>
</odoo>
