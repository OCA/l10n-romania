<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_l10n_ro_edi_enhancements_form" model="ir.ui.view">
        <field name="name">l10n.ro.edi.enhancements.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="l10n_ro_edi.res_config_settings_form_inherit_l10n_ro_edi" />
        <field name="type">form</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='l10n_ro_edi_anaf_imported_inv_journal_id']" position="after">
                <div class="row">
                    <label for="l10n_ro_download_einvoices_days" class="col-lg-3 o_light_label"/>
                    <field name="l10n_ro_download_einvoices_days"/>
                </div>
            </xpath>
        </field>
    </record>


</odoo>