<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
    <record id="ir_cron_res_company_download_message_spv" model="ir.cron">
        <field name="name">Romania e-Invoicing: Download SPV Message</field>
        <field name="model_id" ref="base.model_res_company" />
        <field name="state">code</field>
        <field name="code">model.l10n_ro_download_message_spv()</field>
        <field name="interval_number" eval="1" />
        <field name="interval_type">days</field>
    </record>

    <record id="ir_cron_download_zip_message_spv" model="ir.cron">
        <field name="name">Romania e-Invoicing: Download ZIP SPV Message</field>
        <field name="model_id" ref="base.model_res_company" />
        <field name="state">code</field>
        <field name="code">model.l10n_ro_download_zip_message_spv(limit=5)</field>
        <field name="interval_number" eval="1" />
        <field name="interval_type">days</field>
    </record>
</odoo>
