<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_warehouse_retail" model="ir.ui.view">
        <field name="name">stock.warehouse.form.l10n.ro.retail</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse" />
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="l10n_ro_retail" />
                <field
                    name="l10n_ro_retail_pricelist_id"
                    options="{'no_create': True}"
                    invisible="not l10n_ro_retail"
                />
            </field>
        </field>
    </record>
</odoo>
