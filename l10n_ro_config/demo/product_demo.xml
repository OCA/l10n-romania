        <field name="type">service</field>
        <field name="categ_id" ref="demo_categ_serviciu" />
        <field name="uom_id" ref="uom.product_uom_unit" />
        <field name="list_price">4500.0</field>
        <field name="standard_price">0.0</field>
    </record>

    <!-- ===================================================================
         Taxele implicite ale firmei demo din România.
         Conturile și taxele sunt create pe companie, așa că sunt citite din
         planul de conturi al companiei demo, nu prin ref() direct.
         =================================================================== -->

    <function model="product.template" name="write">
        <value
            eval="[
                ref('demo_product_marfa_standard'),
                ref('demo_product_marfa_avco'),
                ref('demo_product_marfa_serie'),
                ref('demo_product_ambalaj'),
                ref('demo_product_obiect_inventar'),
            ]"
        />
        <value
            model="product.template"
            eval="{
                'taxes_id': [Command.set(obj().env['account.chart.template'].with_company(obj().env.ref('base.demo_company_ro')).ref('tvac_21').ids)],
                'supplier_taxes_id': [Command.set(obj().env['account.chart.template'].with_company(obj().env.ref('base.demo_company_ro')).ref('tvad_21').ids)],
            }"
        />
    </function>

    <function model="product.template" name="write">
        <value
            eval="[
                ref('demo_product_marfa_redusa'),
                ref('demo_product_marfa_lot'),
                ref('demo_product_marfa_avco_lot'),
                ref('demo_product_materie_prima'),
                ref('demo_product_materie_prima_lot'),
                ref('demo_product_produs_finit'),
            ]"
        />
        <value
            model="product.template"
            eval="{
                'taxes_id': [Command.set(obj().env['account.chart.template'].with_company(obj().env.ref('base.demo_company_ro')).ref('tvac_11').ids)],
                'supplier_taxes_id': [Command.set(obj().env['account.chart.template'].with_company(obj().env.ref('base.demo_company_ro')).ref('tvad_11').ids)],
            }"
        />
    </function>

    <function model="product.template" name="write">
        <value
            eval="[
                ref('demo_product_serviciu_consultanta'),
                ref('demo_product_serviciu_transport'),
                ref('demo_product_serviciu_chirie'),
            ]"
        />
        <value
            model="product.template"
            eval="{
                'taxes_id': [Command.set(obj().env['account.chart.template'].with_company(obj().env.ref('base.demo_company_ro')).ref('tvac_21_s').ids)],
                'supplier_taxes_id': [Command.set(obj().env['account.chart.template'].with_company(obj().env.ref('base.demo_company_ro')).ref('tvad_21_s').ids)],
            }"
        />
    </function>
</odoo>
