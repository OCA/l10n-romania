        <field name="parent_id" ref="product.product_category_goods" />
    </record>

    <record id="demo_categ_marfa_avco" model="product.category">
        <field name="name">Mărfuri AVCO (371)</field>
        <field name="parent_id" ref="product.product_category_goods" />
    </record>

    <record id="demo_categ_materie_prima" model="product.category">
        <field name="name">Materii prime (301)</field>
        <field name="parent_id" ref="product.product_category_goods" />
    </record>

    <record id="demo_categ_produs_finit" model="product.category">
        <field name="name">Produse finite (345)</field>
        <field name="parent_id" ref="product.product_category_goods" />
    </record>

    <record id="demo_categ_ambalaj" model="product.category">
