        <field name="type">consu</field>
        <field name="categ_id" ref="demo_categ_obiect_inventar" />
        <field name="uom_id" ref="uom.product_uom_unit" />
        <field name="list_price">780.0</field>
        <field name="standard_price">520.0</field>
