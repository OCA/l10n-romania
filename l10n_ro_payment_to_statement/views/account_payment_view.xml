<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_account_payment_form" model="ir.ui.view">
        <field name="name">l10n.ro.account.payment.form</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group2']" position="inside">
                <!-- deprecated, shown only where the previous behaviour left
                     something behind, to be able to find those lines -->
                <field
                    name="l10n_ro_statement_id"
                    invisible="not l10n_ro_statement_id"
                />
                <field
                    name="l10n_ro_statement_line_id"
                    invisible="not l10n_ro_statement_line_id"
                />
            </xpath>
        </field>
    </record>
</odoo>
