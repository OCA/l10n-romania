<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.l10n.ro.aviz.prices</field>
        <field name="model">res.config.settings</field>
        <field
            name="inherit_id"
            ref="stock.res_config_settings_view_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//block[@name='shipping_setting_container']" position="inside">
                <setting
                    string="Print delivery note (aviz) with prices"
                    help="Print the unit price and value columns on the outgoing Romanian delivery note (aviz). Only affects outgoing pickings."
                >
                    <field name="l10n_ro_print_aviz_with_prices" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
