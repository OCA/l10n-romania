<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="action_report_retail_price_change" model="ir.actions.report">
        <field name="name">Retail Price Change Report</field>
        <field name="model">l10n.ro.retail.price.change</field>
        <field name="report_type">qweb-pdf</field>
        <field
            name="report_name"
        >l10n_ro_stock_account_retail_price_change.report_retail_price_change</field>
        <field
            name="report_file"
        >l10n_ro_stock_account_retail_price_change.report_retail_price_change</field>
        <field name="print_report_name">object.name</field>
        <field name="binding_model_id" ref="model_l10n_ro_retail_price_change" />
        <field name="binding_type">report</field>
    </record>

    <template id="report_retail_price_change">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <!-- Document legal RO fără partener: limba companiei (ro_RO).
                     Documentul propriu-zis e un template separat, chemat cu
                     t-lang, ca întregul conținut (nu doar layout-ul) să fie
                     tradus. -->
                <t t-set="lang" t-value="doc.company_id.partner_id.lang or 'ro_RO'" />
                <t
                    t-call="l10n_ro_stock_account_retail_price_change.report_retail_price_change_document"
                    t-lang="lang"
                />
            </t>
        </t>
    </template>

    <template id="report_retail_price_change_document">
        <t t-call="web.external_layout">
            <t t-set="doc" t-value="doc.with_context(lang=lang)" />
            <div class="page">
                <h4 class="text-center">Proces-verbal de modificare a prețurilor</h4>
                <div class="text-center mb-3">
                    <span t-field="doc.name" />
                    <span> din </span>
                    <span t-field="doc.date" />
                </div>

                <div class="row mb-3">
                    <div class="col-6">
                        <strong>Gestiune:</strong>
                        <span t-field="doc.warehouse_id" />
                        <div t-if="doc.warehouse_id.partner_id">
                            <span
                                t-field="doc.warehouse_id.partner_id"
                                t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'
                            />
                        </div>
                    </div>
                    <div class="col-6">
                        <strong>Listă de prețuri:</strong>
                        <span t-field="doc.pricelist_id" />
                    </div>
                </div>

                <p>
                    Având în vedere evoluția cererii și a ofertei pe piață,
                    se modifică prețul cu amănuntul al următoarelor mărfuri
                    aflate în stoc, în limita adaosului comercial practicat.
                    Prețurile sunt exprimate cu TVA inclus.
                </p>

                <table class="table table-sm table-bordered">
                    <thead>
                        <tr>
                            <th class="text-center">Nr.</th>
                            <th class="text-nowrap">Cod</th>
                            <th>Produs</th>
                            <th class="text-center">U.M.</th>
                            <th class="text-end">Cantitate</th>
                            <th class="text-end">Preț vechi</th>
                            <th class="text-end">Preț nou</th>
                            <th class="text-end">Diferență unitară</th>
                            <th class="text-end">Valoare veche</th>
                            <th class="text-end">Valoare nouă</th>
                            <th class="text-end">Diferență</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="seq" t-value="0" />
                        <t t-set="total_old" t-value="0" />
                        <t t-set="total_new" t-value="0" />
                        <t t-foreach="doc.line_ids" t-as="line">
                            <t t-set="seq" t-value="seq + 1" />
                            <t
                                t-set="old_value"
                                t-value="line.old_price_with_vat * line.quantity"
                            />
                            <t
                                t-set="new_value"
                                t-value="line.new_price_with_vat * line.quantity"
                            />
                            <t t-set="total_old" t-value="total_old + old_value" />
                            <t t-set="total_new" t-value="total_new + new_value" />
                            <t t-set="dc" t-value="line.product_id.default_code" />
                            <t t-set="pname" t-value="line.product_id.display_name or ''" />
                            <t
                                t-if="dc and pname.startswith('[' + dc + ']')"
                                t-set="pname"
                                t-value="pname[len('[' + dc + ']'):].strip()"
                            />
                            <tr>
                                <td class="text-center">
                                    <span t-esc="seq" />
                                </td>
                                <td class="text-nowrap">
                                    <span t-esc="dc or ''" />
                                </td>
                                <td>
                                    <span t-esc="pname" />
                                </td>
                                <td class="text-center">
                                    <span t-field="line.product_id.uom_id" />
                                </td>
                                <td class="text-end">
                                    <span t-field="line.quantity" />
                                </td>
                                <td class="text-end">
                                    <span
                                        t-esc="line.old_price_with_vat"
                                        t-options="{'widget': 'float', 'precision': 2}"
                                    />
                                </td>
                                <td class="text-end">
                                    <span
                                        t-esc="line.new_price_with_vat"
                                        t-options="{'widget': 'float', 'precision': 2}"
                                    />
                                </td>
                                <td class="text-end">
                                    <span
                                        t-esc="line.new_price_with_vat - line.old_price_with_vat"
                                        t-options="{'widget': 'float', 'precision': 2}"
                                    />
                                </td>
                                <td class="text-end">
                                    <span
                                        t-esc="old_value"
                                        t-options="{'widget': 'float', 'precision': 2}"
                                    />
                                </td>
                                <td class="text-end">
                                    <span
                                        t-esc="new_value"
                                        t-options="{'widget': 'float', 'precision': 2}"
                                    />
                                </td>
                                <td class="text-end">
                                    <span
                                        t-esc="new_value - old_value"
                                        t-options="{'widget': 'float', 'precision': 2}"
                                    />
                                </td>
                            </tr>
                        </t>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="8" class="text-end">
                                <strong>Total</strong>
                            </td>
                            <td class="text-end">
                                <strong
                                    t-esc="total_old"
                                    t-options="{'widget': 'float', 'precision': 2}"
                                />
                            </td>
                            <td class="text-end">
                                <strong
                                    t-esc="total_new"
                                    t-options="{'widget': 'float', 'precision': 2}"
                                />
                            </td>
                            <td class="text-end">
                                <strong
                                    t-esc="total_new - total_old"
                                    t-options="{'widget': 'float', 'precision': 2}"
                                />
                            </td>
                        </tr>
                    </tfoot>
                </table>

                <h6 class="mt-4">Defalcarea diferenței pe conturi</h6>
                <table class="table table-sm table-bordered">
                    <thead>
                        <tr>
                            <th>Produs</th>
                            <th class="text-end">Adaos comercial (378)</th>
                            <th class="text-end">TVA neexigibilă (4428)</th>
                            <th class="text-end">Total (371)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="total_markup" t-value="0" />
                        <t t-set="total_vat" t-value="0" />
                        <t t-foreach="doc.line_ids" t-as="line">
                            <t
                                t-set="total_markup"
                                t-value="total_markup + line.markup_diff_total"
                            />
                            <t t-set="total_vat" t-value="total_vat + line.vat_diff_total" />
                            <tr>
                                <td>
                                    <span t-field="line.product_id" />
                                </td>
                                <td class="text-end">
                                    <span
                                        t-field="line.markup_diff_total"
                                        t-options="{'widget': 'float', 'precision': 2}"
                                    />
                                </td>
                                <td class="text-end">
                                    <span
                                        t-field="line.vat_diff_total"
                                        t-options="{'widget': 'float', 'precision': 2}"
                                    />
                                </td>
                                <td class="text-end">
                                    <span
                                        t-esc="line.markup_diff_total + line.vat_diff_total"
                                        t-options="{'widget': 'float', 'precision': 2}"
                                    />
                                </td>
                            </tr>
                        </t>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td class="text-end">
                                <strong>Total</strong>
                            </td>
                            <td class="text-end">
                                <strong
                                    t-esc="total_markup"
                                    t-options="{'widget': 'float', 'precision': 2}"
                                />
                            </td>
                            <td class="text-end">
                                <strong
                                    t-esc="total_vat"
                                    t-options="{'widget': 'float', 'precision': 2}"
                                />
                            </td>
                            <td class="text-end">
                                <strong
                                    t-esc="total_markup + total_vat"
                                    t-options="{'widget': 'float', 'precision': 2}"
                                />
                            </td>
                        </tr>
                    </tfoot>
                </table>

                <div t-if="doc.notes" class="mt-3">
                    <span t-field="doc.notes" />
                </div>

                <div class="row mt-4" style="page-break-inside: avoid;">
                    <div class="col-4">
                        <p>Întocmit,</p>
                        <p class="mt-5">.............................</p>
                    </div>
                    <div class="col-4">
                        <p>Gestionar,</p>
                        <p class="mt-5">.............................</p>
                    </div>
                    <div class="col-4">
                        <p>Aprobat,</p>
                        <p class="mt-5">.............................</p>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
