<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="action_report_retail_price_change" model="ir.actions.report">
        <field name="name">Retail Price Change Report</field>
        <field name="model">l10n.ro.retail.price.change</field>
        <field name="report_type">qweb-pdf</field>
        <field
            name="report_name"
        >l10n_ro_stock_account_retail_price_change.report_retail_price_change</field>
        <field
            name="report_file"
        >l10n_ro_stock_account_retail_price_change.report_retail_price_change</field>
        <field name="print_report_name">object.name</field>
        <field name="binding_model_id" ref="model_l10n_ro_retail_price_change" />
        <field name="binding_type">report</field>
    </record>

    <template id="report_retail_price_change">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h4 class="text-center">Retail Price Change Report</h4>
                        <div class="text-center mb-3">
                            <span t-field="doc.name" />
                            <span> of </span>
                            <span t-field="doc.date" />
                        </div>

                        <div class="row mb-3">
                            <div class="col-6">
                                <strong>Warehouse:</strong>
                                <span t-field="doc.warehouse_id" />
                            </div>
                            <div class="col-6">
                                <strong>Pricelist:</strong>
                                <span t-field="doc.pricelist_id" />
                            </div>
                        </div>

                        <p>
                            Given the movement of supply and demand on the market,
                            the retail price of the following goods held in stock is
                            changed, within the commercial markup practised. Prices
                            are stated VAT included.
                        </p>

                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th class="text-center">No.</th>
                                    <th>Product</th>
                                    <th class="text-center">UoM</th>
                                    <th class="text-end">Quantity</th>
                                    <th class="text-end">Old Price</th>
                                    <th class="text-end">New Price</th>
                                    <th class="text-end">Old Value</th>
                                    <th class="text-end">New Value</th>
                                    <th class="text-end">Difference</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="seq" t-value="0" />
                                <t t-set="total_old" t-value="0" />
                                <t t-set="total_new" t-value="0" />
                                <t t-foreach="doc.line_ids" t-as="line">
                                    <t t-set="seq" t-value="seq + 1" />
                                    <t
                                        t-set="old_value"
                                        t-value="line.old_price_with_vat * line.quantity"
                                    />
                                    <t
                                        t-set="new_value"
                                        t-value="line.new_price_with_vat * line.quantity"
                                    />
                                    <t
                                        t-set="total_old"
                                        t-value="total_old + old_value"
                                    />
                                    <t
                                        t-set="total_new"
                                        t-value="total_new + new_value"
                                    />
                                    <tr>
                                        <td class="text-center">
                                            <span t-esc="seq" />
                                        </td>
                                        <td>
                                            <span t-field="line.product_id" />
                                        </td>
                                        <td class="text-center">
                                            <span t-field="line.product_id.uom_id" />
                                        </td>
                                        <td class="text-end">
                                            <span t-field="line.quantity" />
                                        </td>
                                        <td class="text-end">
                                            <span
                                                t-esc="line.old_price_with_vat"
                                                t-options="{'widget': 'float', 'precision': 2}"
                                            />
                                        </td>
                                        <td class="text-end">
                                            <span
                                                t-esc="line.new_price_with_vat"
                                                t-options="{'widget': 'float', 'precision': 2}"
                                            />
                                        </td>
                                        <td class="text-end">
                                            <span
                                                t-esc="old_value"
                                                t-options="{'widget': 'float', 'precision': 2}"
                                            />
                                        </td>
                                        <td class="text-end">
                                            <span
                                                t-esc="new_value"
                                                t-options="{'widget': 'float', 'precision': 2}"
                                            />
                                        </td>
                                        <td class="text-end">
                                            <span
                                                t-esc="new_value - old_value"
                                                t-options="{'widget': 'float', 'precision': 2}"
                                            />
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="6" class="text-end">
                                        <strong>Total</strong>
                                    </td>
                                    <td class="text-end">
                                        <strong
                                            t-esc="total_old"
                                            t-options="{'widget': 'float', 'precision': 2}"
                                        />
                                    </td>
                                    <td class="text-end">
                                        <strong
                                            t-esc="total_new"
                                            t-options="{'widget': 'float', 'precision': 2}"
                                        />
                                    </td>
                                    <td class="text-end">
                                        <strong
                                            t-esc="total_new - total_old"
                                            t-options="{'widget': 'float', 'precision': 2}"
                                        />
                                    </td>
                                </tr>
                            </tfoot>
                        </table>

                        <h6 class="mt-4">Breakdown of the difference by account</h6>
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th class="text-end">Commercial Markup (378)</th>
                                    <th class="text-end">Deferred VAT (4428)</th>
                                    <th class="text-end">Total (371)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="total_markup" t-value="0" />
                                <t t-set="total_vat" t-value="0" />
                                <t t-foreach="doc.line_ids" t-as="line">
                                    <t
                                        t-set="total_markup"
                                        t-value="total_markup + line.markup_diff_total"
                                    />
                                    <t
                                        t-set="total_vat"
                                        t-value="total_vat + line.vat_diff_total"
                                    />
                                    <tr>
                                        <td>
                                            <span t-field="line.product_id" />
                                        </td>
                                        <td class="text-end">
                                            <span
                                                t-field="line.markup_diff_total"
                                                t-options="{'widget': 'float', 'precision': 2}"
                                            />
                                        </td>
                                        <td class="text-end">
                                            <span
                                                t-field="line.vat_diff_total"
                                                t-options="{'widget': 'float', 'precision': 2}"
                                            />
                                        </td>
                                        <td class="text-end">
                                            <span
                                                t-esc="line.markup_diff_total + line.vat_diff_total"
                                                t-options="{'widget': 'float', 'precision': 2}"
                                            />
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td class="text-end">
                                        <strong>Total</strong>
                                    </td>
                                    <td class="text-end">
                                        <strong
                                            t-esc="total_markup"
                                            t-options="{'widget': 'float', 'precision': 2}"
                                        />
                                    </td>
                                    <td class="text-end">
                                        <strong
                                            t-esc="total_vat"
                                            t-options="{'widget': 'float', 'precision': 2}"
                                        />
                                    </td>
                                    <td class="text-end">
                                        <strong
                                            t-esc="total_markup + total_vat"
                                            t-options="{'widget': 'float', 'precision': 2}"
                                        />
                                    </td>
                                </tr>
                            </tfoot>
                        </table>

                        <div t-if="doc.notes" class="mt-3">
                            <span t-field="doc.notes" />
                        </div>

                        <div class="row mt-5">
                            <div class="col-4">
                                <p>Prepared by,</p>
                                <p class="mt-4">.............................</p>
                            </div>
                            <div class="col-4">
                                <p>Stock keeper,</p>
                                <p class="mt-4">.............................</p>
                            </div>
                            <div class="col-4">
                                <p>Approved by,</p>
                                <p class="mt-4">.............................</p>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
