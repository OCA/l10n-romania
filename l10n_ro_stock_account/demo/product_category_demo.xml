<odoo>
    <!-- Categoriile din l10n_ro_config primesc aici gestiunea cantitativ-
         valorică: evaluare permanentă, FIFO și conturile din planul de
         conturi român. Conturile sunt pe companie, de aceea înregistrările
         se scriu în contextul firmei demo din România. -->

    <record
        id="l10n_ro_config.demo_categ_marfa"
        model="product.category"
        context="{'allowed_company_ids': [ref('base.demo_company_ro')]}"
    >
        <field name="property_valuation">real_time</field>
        <field name="property_cost_method">fifo</field>
        <field name="l10n_ro_stock_account_change" eval="True" />
        <field
            name="property_stock_valuation_account_id"
            model="account.chart.template"
            eval="obj().with_company(obj().env.ref('base.demo_company_ro')).ref('pcg_371').id"
        />
        <field
            name="property_account_expense_categ_id"
            model="account.chart.template"
            eval="obj().with_company(obj().env.ref('base.demo_company_ro')).ref('ro_pcg_expense').id"
        />
        <field
            name="property_account_income_categ_id"
            model="account.chart.template"
            eval="obj().with_company(obj().env.ref('base.demo_company_ro')).ref('ro_pcg_sale').id"
        />
    </record>

