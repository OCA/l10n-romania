    <!-- ===================================================================
         Stocul inițial al firmei demo, descris în demo/cases/stoc_initial.csv
         ca pași de inventariere, în același format ca scenariile din teste.
         Intrarea se evaluează la costul produsului și creează straturile FIFO
         pe locație.

         Produsele și loturile sunt căutate direct din fișier, după referința
         internă și după nume, așa că harta de mai jos poartă doar gestiunile,
         care n-au cod după care să fie găsite.
         =================================================================== -->

    <function
        model="l10n.ro.stock.scenario.loader"
        name="_load_cases"
        context="{'allowed_company_ids': [ref('base.demo_company_ro')]}"
    >
        <value>l10n_ro_stock_account</value>
        <value>stoc_initial.csv</value>
        <value
            eval="{
                'zona_a': 'l10n_ro_stock.demo_location_zone_a',
                'zona_b': 'l10n_ro_stock.demo_location_zone_b',
                'depozit_central': 'l10n_ro_stock.demo_warehouse_main::lot_stock_id',
                'depozit_timisoara': 'l10n_ro_stock.demo_warehouse_secondary::lot_stock_id',
            }"
        />
    </function>
