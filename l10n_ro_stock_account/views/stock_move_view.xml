<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_stock_move_form_fifo_neg" model="ir.ui.view">
        <field name="name">stock.move.form.fifo.neg</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group
                    string="FIFO Negative Stock Compensation"
                    invisible="not fifo_neg_pending_qty and not fifo_neg_origin_value"
                >
                    <field name="fifo_neg_pending_qty" />
                    <field name="fifo_neg_origin_value" />
                    <field
                        name="fifo_neg_compensation_move_ids"
                        nolabel="1"
                        readonly="1"
                    >
                        <list>
                            <field name="name" />
                            <field name="date" />
                            <field name="amount_total" />
                            <field name="state" />
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
