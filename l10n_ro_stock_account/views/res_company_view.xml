<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_company_form_fifo_location" model="ir.ui.view">
        <field name="name">res.company.form.fifo.location</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_info']" position="inside">
                <group string="FIFO per Location">
                    <field name="fifo_per_location" />
                    <field
                        name="fifo_location_negative_compensation"
                        invisible="not fifo_per_location"
                    />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
