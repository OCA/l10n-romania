<odoo>
    <!-- Import din afara Uniunii: furnizorul facturează fără TVA, iar
         taxele vamale și TVA-ul se stabilesc prin declarația vamală.
         Taxa vamală și comisionul vamal intră în costul mărfii, prin
         mecanismul de cost suplimentar de achiziție. -->

    <record
        id="demo_purchase_order_import"
        model="purchase.order"
        context="{'allowed_company_ids': [ref('base.demo_company_ro')]}"
    >
        <field name="company_id" ref="base.demo_company_ro" />
        <field
            name="partner_id"
            ref="l10n_ro_config.demo_partner_noneu_company_supplier_cn"
        />
        <field
            name="picking_type_id"
            model="stock.picking.type"
            eval="obj().env.ref('l10n_ro_stock.demo_warehouse_main').in_type_id.id"
        />
        <field
            name="order_line"
            model="purchase.order.line"
            eval="[
                (0, 0, {
                    'product_id': obj().env.ref('l10n_ro_config.demo_product_marfa_standard').product_variant_id.id,
                    'product_qty': 10.0,
                    'price_unit': 600.0,
                    'tax_ids': [(6, 0, [])],
                    'name': 'Espressor automat ClassicBrew - import',
                    'date_planned': time.strftime('%Y-%m-%d'),
                }),
            ]"
        />
    </record>

    <function
        model="purchase.order"
        name="button_confirm"
        context="{'allowed_company_ids': [ref('base.demo_company_ro')]}"
    >
        <value eval="[ref('demo_purchase_order_import')]" />
    </function>

    <function
        model="stock.picking"
        name="button_validate"
        context="{'allowed_company_ids': [ref('base.demo_company_ro')]}"
    >
        <value
            model="stock.picking"
            eval="obj().env.ref('l10n_ro_dvi.demo_purchase_order_import').picking_ids.ids"
        />
    </function>

    <record
        id="demo_bill_import"
        model="account.move"
        context="{'allowed_company_ids': [ref('base.demo_company_ro')]}"
    >
        <field name="company_id" ref="base.demo_company_ro" />
        <field name="move_type">in_invoice</field>
        <field
            name="partner_id"
            ref="l10n_ro_config.demo_partner_noneu_company_supplier_cn"
        />
        <field name="invoice_date" eval="time.strftime('%Y-%m-%d')" />
        <field name="ref">INV-SZGT-2026-001</field>
        <field
            name="invoice_line_ids"
            model="account.move.line"
            eval="[
                (0, 0, {
                    'product_id': obj().env.ref('l10n_ro_config.demo_product_marfa_standard').product_variant_id.id,
                    'quantity': 10.0,
                    'price_unit': 600.0,
                    'tax_ids': [(6, 0, [])],
                    'purchase_line_id': obj().env.ref('l10n_ro_dvi.demo_purchase_order_import').order_line[0].id,
                }),
            ]"
        />
    </record>

    <function
        model="account.move"
        name="action_post"
        context="{
            'allowed_company_ids': [ref('base.demo_company_ro')],
            'l10n_ro_approved_price_difference': True,
        }"
    >
        <value eval="[ref('demo_bill_import')]" />
    </function>

    <!-- Declarația vamală de import: taxă vamală 300 lei, comision vamal
         100 lei, TVA 21% calculat pe valoarea în vamă. -->

    <record
        id="demo_dvi_import"
        model="l10n.ro.account.dvi"
        context="{'allowed_company_ids': [ref('base.demo_company_ro')]}"
    >
        <field name="name">DVI/2026/0001</field>
        <field name="date" eval="time.strftime('%Y-%m-%d')" />
        <field name="company_id" ref="base.demo_company_ro" />
        <field
            name="journal_id"
            model="account.journal"
            eval="obj().env['account.journal'].search([('type', '=', 'general'), ('company_id', '=', obj().env.ref('base.demo_company_ro').id)], limit=1).id"
        />
        <field
            name="tax_id"
            model="account.chart.template"
            eval="obj().with_company(obj().env.ref('base.demo_company_ro')).ref('tvad_21').id"
        />
        <field name="customs_duty_value">300.0</field>
        <field name="customs_commission_value">100.0</field>
        <field name="invoice_ids" eval="[Command.set([ref('demo_bill_import')])]" />
    </record>

    <function
        model="l10n.ro.account.dvi.line"
        name="write"
        context="{'allowed_company_ids': [ref('base.demo_company_ro')]}"
    >
        <value
            model="l10n.ro.account.dvi.line"
            eval="obj().env.ref('l10n_ro_dvi.demo_dvi_import').line_ids.ids"
        />
        <value model="l10n.ro.account.dvi.line" eval="{'line_qty': 10.0}" />
    </function>

    <function
        model="l10n.ro.account.dvi"
        name="button_post"
        context="{'allowed_company_ids': [ref('base.demo_company_ro')]}"
    >
        <value eval="[ref('demo_dvi_import')]" />
    </function>

    <function
        model="stock.landed.cost"
        name="button_validate"
        context="{'allowed_company_ids': [ref('base.demo_company_ro')]}"
    >
        <value
            model="stock.landed.cost"
            eval="obj().env.ref('l10n_ro_dvi.demo_dvi_import').landed_cost_ids.ids"
        />
    </function>
</odoo>
