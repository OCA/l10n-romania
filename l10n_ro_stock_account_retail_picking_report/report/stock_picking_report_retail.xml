<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Goods entering a shop print the base NIR (cost, charges, subtotal, VAT,
         total) and, appended on the right, the retail split the shop signs
         for: how much is added on top, the deferred VAT and the shelf value. -->
    <template
        id="report_delivery_document"
        inherit_id="l10n_ro_stock_picking_valued_report.report_delivery_document"
        priority="110"
    >
        <!-- Header cells, appended after the base "Total" column. -->
        <xpath expr="//table[@name='l10n_ro_nir_table']/thead/tr" position="inside">
            <t t-if="o.l10n_ro_retail_incoming">
                <th class="text-end" name="th_nir_markup">
                    <strong>Markup (% / value)</strong>
                </th>
                <th class="text-end" name="th_nir_retail_no_vat">
                    <strong>Retail Price excl. VAT</strong>
                </th>
                <th class="text-end" name="th_nir_retail_vat">
                    <strong>Retail Price incl. VAT</strong>
                </th>
                <th class="text-end" name="th_nir_deferred_vat">
                    <strong>Deferred VAT</strong>
                </th>
                <th class="text-end" name="th_nir_retail_value">
                    <strong>Retail Sale Value</strong>
                </th>
            </t>
        </xpath>

        <!-- One cell set per NIR row (one per move). -->
        <xpath
            expr="//table[@name='l10n_ro_nir_table']/tbody/tr[@name='nir_row']"
            position="inside"
        >
            <t t-if="o.l10n_ro_retail_incoming">
                <t t-set="rv" t-value="line['move']._l10n_ro_retail_nir_values()" />
                <td class="text-end" name="td_nir_markup">
                    <span t-out="'%.2f' % rv['markup_percent']" />%
                    /
                    <span t-out="nir_num(rv['markup'])" />
                </td>
                <td class="text-end" name="td_nir_retail_no_vat">
                    <span t-out="'%.4f' % rv['retail_price_no_vat_unit']" />
                </td>
                <td class="text-end" name="td_nir_retail_vat">
                    <span t-out="'%.4f' % rv['retail_price_vat_unit']" />
                </td>
                <td class="text-end" name="td_nir_deferred_vat">
                    <span t-out="nir_num(rv['vat'])" />
                </td>
                <td class="text-end" name="td_nir_retail_value">
                    <span t-out="nir_num(rv['retail_value'])" />
                </td>
            </t>
        </xpath>

        <!-- Totals, appended after the base total row's "Total" cell. -->
        <xpath
            expr="//table[@name='l10n_ro_nir_table']/tfoot/tr[@name='nir_total_row']"
            position="inside"
        >
            <t t-if="o.l10n_ro_retail_incoming">
                <td class="text-end" name="tf_nir_markup">
                    <strong
                        t-out="nir_num(sum(line['move']._l10n_ro_retail_nir_values()['markup'] for line in nir_lines))"
                    />
                </td>
                <td name="tf_nir_retail_no_vat" />
                <td name="tf_nir_retail_vat" />
                <td class="text-end" name="tf_nir_deferred_vat">
                    <strong
                        t-out="nir_num(sum(line['move']._l10n_ro_retail_nir_values()['vat'] for line in nir_lines))"
                    />
                </td>
                <td class="text-end" name="tf_nir_retail_value">
                    <strong
                        t-out="nir_num(sum(line['move']._l10n_ro_retail_nir_values()['retail_value'] for line in nir_lines))"
                    />
                </td>
            </t>
        </xpath>
    </template>
</odoo>
